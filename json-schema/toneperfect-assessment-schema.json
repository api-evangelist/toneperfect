        "expected": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "heard": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "decision": {
          "type": "string",
          "description": "Correction decision: `review` (strong evidence of an error), `uncertain`, `no_correction`; `unassessable`, `partial` and `legacy_correction` also occur. Treat any other value as no decision."
        },
        "flagged": {
          "type": "boolean"
