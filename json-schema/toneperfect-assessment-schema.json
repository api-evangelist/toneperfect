    "Phone": {
      "type": "object",
      "description": "One sound. Mandarin rows describe a syllable component (`dimension` initial, final or tone; tones are integers 1–5). Other languages describe a phoneme with timing and an alignment operation.",
      "properties": {
        "dimension": {
          "type": "string"
